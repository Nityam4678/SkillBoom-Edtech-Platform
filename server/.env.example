NODE_ENV=development
PORT=4000
MONGODB_URL=mongodb://127.0.0.1:27017/Study_Notion
CLIENT_URL=http://localhost:3000
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

CLOUD_NAME=your-cloudinary-cloud-name
API_KEY=your-cloudinary-api-key
API_SECRET=your-cloudinary-api-secret
FOLDER_NAME=skillboom

RESEND_API_KEY=
# Local Resend testing: use onboarding@resend.dev and send only to the Resend account email.
# Production: replace with no-reply@skillboom.com after verifying skillboom.com in Resend.
EMAIL_FROM=onboarding@resend.dev

JWT_SECRET=replace-with-a-long-random-secret
RAZORPAY_KEY=your-razorpay-key-id
RAZORPAY_SECRET=your-razorpay-key-secret
